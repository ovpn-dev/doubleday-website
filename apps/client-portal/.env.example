# Copy this file to apps/client-portal/.env.local and fill in real values.
# Never commit apps/client-portal/.env.local — already covered by
# .gitignore's .env.local pattern.

# SAME working DATABASE_URL used elsewhere in this monorepo (the Supabase
# pooler connection string — see packages/database/README.md).
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Random secret signing client session cookies. MUST be a DIFFERENT value
# from apps/admin's SESSION_SECRET — the two auth systems are deliberately
# separate, and sharing a secret between them would let one forge the
# other's sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_SESSION_SECRET="replace-with-a-different-long-random-generated-value"
