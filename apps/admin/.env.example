# Copy this file to apps/admin/.env.local and fill in real values.
# Never commit apps/admin/.env.local — it's already covered by .gitignore's
# .env.local pattern.

# SAME working DATABASE_URL you're using in packages/database/.env (the
# Supabase pooler connection string, not the direct db.*.supabase.co:5432
# one — see packages/database/README.md for why).
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# The password required to sign in to this admin app. Pick something only
# you and your dad know — this is a single shared password, not a
# per-person account (see apps/admin/README.md for why).
ADMIN_PASSWORD="choose-a-real-password-here"

# Random secret used to sign session cookies so they can't be forged.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters. Keep this secret — anyone with it can
# forge a valid session without knowing ADMIN_PASSWORD.
SESSION_SECRET="replace-with-a-long-random-generated-value"
