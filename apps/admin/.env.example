# Copy this file to apps/admin/.env.local and set it to the SAME working
# DATABASE_URL you're using in packages/database/.env (the Supabase pooler
# connection string, not the direct db.*.supabase.co:5432 one).
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
